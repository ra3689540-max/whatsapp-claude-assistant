# Copy this file to ".env" and fill it in. Never share your .env file: the key inside works like a password.

# Free key for turning voice notes into text: https://console.groq.com/keys  (sign in > Create API Key)
GROQ_API_KEY=

# Language of the summaries and replies: english or roman-urdu
REPLY_LANGUAGE=english

# Summarise voice notes in groups too (no reply suggestions for groups): yes / no
GROUPS=yes

# Safety limit: max replies sent per hour (keeps your number safe)
MAX_SENDS_PER_HOUR=15

# Currency shown on expenses and bills, e.g. Rs, PKR, ₹, $
CURRENCY=Rs

# Bill reminders go out at this hour (24 h clock): 2 days before the due date and on the due date
REMINDER_HOUR=10

# Lets the assistant use your Claude Pro/Max plan in the background. Run "claude setup-token", log in, paste it here.
# Can stay empty only if a separately installed Claude Code ("claude" in a terminal) is already logged in.
CLAUDE_CODE_OAUTH_TOKEN=

# Logs only message TYPES (never content) to help find problems: yes / no
DEBUG=no
